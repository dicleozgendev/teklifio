rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasWorkspace() {
      return signedIn() && exists(userPath())
        && (!('status' in get(userPath()).data) || get(userPath()).data.status == 'active');
    }

    function organizationId() {
      return get(userPath()).data.organizationId;
    }

    function ownsExistingDocument() {
      return hasWorkspace() && resource.data.organizationId == organizationId();
    }

    function writesOwnOrganization() {
      return hasWorkspace() && currentRole() != 'viewer'
        && request.resource.data.organizationId == organizationId();
    }

    function canDeleteExistingDocument() {
      return ownsExistingDocument() && currentRole() != 'viewer';
    }

    function isMinimalShare(data) {
      return data.keys().hasOnly(['token', 'quoteId', 'organizationId', 'active', 'expiresAt', 'quote', 'customer', 'settings', 'createdBy', 'createdAt', 'updatedAt'])
        && data.quote.keys().hasOnly(['id', 'date', 'validUntil', 'items', 'note', 'currency'])
        && data.customer.keys().hasOnly(['company', 'name'])
        && data.settings.keys().hasOnly(['companyName', 'address', 'email']);
    }

    function validRole(role) {
      return role in ['owner', 'admin', 'member', 'viewer'];
    }

    function currentRole() { return get(userPath()).data.role; }
    function isOwner() { return hasWorkspace() && currentRole() == 'owner'; }
    function isManager() { return hasWorkspace() && currentRole() in ['owner', 'admin']; }

    function hasRegistrationAuthorization() {
      return signedIn()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/registrationAuthorizations/$(request.auth.token.email))
        && get(/databases/$(database)/documents/registrationAuthorizations/$(request.auth.token.email)).data.email == request.auth.token.email
        && get(/databases/$(database)/documents/registrationAuthorizations/$(request.auth.token.email)).data.active == true
        && request.time < get(/databases/$(database)/documents/registrationAuthorizations/$(request.auth.token.email)).data.expiresAt;
    }

    match /registrationAuthorizations/{email} {
      allow read, write: if false;
    }

    match /organizations/{orgId} {
      allow create: if signedIn()
        && hasRegistrationAuthorization()
        && orgId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.registrationEmail == request.auth.token.email;
      allow read: if hasWorkspace() && orgId == organizationId();
      allow update: if isManager()
        && orgId == organizationId()
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if hasWorkspace()
        && orgId == organizationId()
        && resource.data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.emailVerificationRequired == true
        && request.resource.data.status == 'active'
        && ((request.resource.data.role == 'owner'
          && hasRegistrationAuthorization()
          && request.resource.data.email == request.auth.token.email
          && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.ownerId == request.auth.uid)
        || (request.resource.data.role in ['admin', 'member', 'viewer']
          && request.resource.data.inviteId is string
          && exists(/databases/$(database)/documents/invitations/$(request.resource.data.inviteId))
          && get(/databases/$(database)/documents/invitations/$(request.resource.data.inviteId)).data.status == 'pending'
          && get(/databases/$(database)/documents/invitations/$(request.resource.data.inviteId)).data.organizationId == request.resource.data.organizationId
          && get(/databases/$(database)/documents/invitations/$(request.resource.data.inviteId)).data.role == request.resource.data.role
          && get(/databases/$(database)/documents/invitations/$(request.resource.data.inviteId)).data.email == request.resource.data.email
          && request.auth.token.email == request.resource.data.email
          && request.time < get(/databases/$(database)/documents/invitations/$(request.resource.data.inviteId)).data.expiresAt));
      allow read: if signedIn() && (userId == request.auth.uid
        || (isManager() && resource.data.organizationId == organizationId()));
      allow update: if (signedIn()
        && userId == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && validRole(request.resource.data.role))
        || (isOwner()
          && userId != request.auth.uid
          && resource.data.organizationId == organizationId()
          && resource.data.role != 'owner'
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.email == resource.data.email
          && request.resource.data.role in ['admin', 'member', 'viewer']
          && request.resource.data.status in ['active', 'disabled']);
      allow delete: if false;
    }

    match /invitations/{invitationId} {
      allow create: if isManager()
        && request.resource.data.id == invitationId
        && request.resource.data.organizationId == organizationId()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.role in ['admin', 'member', 'viewer']
        && request.resource.data.email is string
        && request.resource.data.expiresAt > request.time;
      allow read: if (isManager() && resource.data.organizationId == organizationId())
        || (signedIn() && request.auth.token.email == resource.data.email);
      allow update: if (isManager()
          && resource.data.organizationId == organizationId()
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && request.resource.data.expiresAt == resource.data.expiresAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled')
        || (signedIn()
          && request.auth.token.email == resource.data.email
          && resource.data.status == 'pending'
          && request.resource.data.status == 'accepted'
          && request.resource.data.acceptedBy == request.auth.uid
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && request.resource.data.expiresAt == resource.data.expiresAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt', 'updatedAt'])
          && request.time < resource.data.expiresAt);
      allow delete: if false;
    }

    match /customers/{documentId} {
      allow read: if ownsExistingDocument();
      allow delete: if canDeleteExistingDocument();
      allow create: if writesOwnOrganization();
      allow update: if ownsExistingDocument() && writesOwnOrganization();
    }

    match /products/{documentId} {
      allow read: if ownsExistingDocument();
      allow delete: if canDeleteExistingDocument();
      allow create: if writesOwnOrganization();
      allow update: if ownsExistingDocument() && writesOwnOrganization();
    }

    match /quotes/{documentId} {
      allow read: if ownsExistingDocument();
      allow delete: if canDeleteExistingDocument();
      allow create: if writesOwnOrganization();
      allow update: if ownsExistingDocument() && writesOwnOrganization();
    }

    match /quoteItems/{documentId} {
      allow read: if ownsExistingDocument();
      allow delete: if canDeleteExistingDocument();
      allow create: if writesOwnOrganization();
      allow update: if ownsExistingDocument() && writesOwnOrganization();
    }

    match /quoteVersions/{documentId} {
      allow read: if ownsExistingDocument();
      allow create: if writesOwnOrganization()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.quoteId is string;
      allow update, delete: if false;
    }

    match /quoteActivities/{documentId} {
      allow read: if ownsExistingDocument();
      allow create: if writesOwnOrganization()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.type in ['created', 'pdf_downloaded', 'share_created', 'share_revoked', 'status_changed']
        && (!('status' in request.resource.data) || request.resource.data.status in ['Taslak', 'Gönderildi', 'Onaylandı', 'Reddedildi']);
      allow update, delete: if false;
    }

    match /quoteShares/{token} {
      allow get: if resource.data.active == true
        && request.time < resource.data.expiresAt
        && isMinimalShare(resource.data);
      allow list: if hasWorkspace() && resource.data.organizationId == organizationId();
      allow create: if writesOwnOrganization()
        && request.resource.data.token == token
        && token.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')
        && isMinimalShare(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(30, 'd');
      allow update: if ownsExistingDocument() && writesOwnOrganization()
        && request.resource.data.token == resource.data.token
        && request.resource.data.quoteId == resource.data.quoteId
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.expiresAt == resource.data.expiresAt
        && resource.data.active == true
        && request.resource.data.active == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'updatedAt']);
      allow delete: if false;
    }

    match /apiRateLimits/{bucketId} {
      allow get: if hasWorkspace()
        && bucketId.matches('^' + request.auth.uid + '_(ai-quote|client-error)_[0-9]+$');
      allow list, delete: if false;
      allow create: if hasWorkspace()
        && bucketId.matches('^' + request.auth.uid + '_(ai-quote|client-error)_[0-9]+$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.organizationId == organizationId()
        && request.resource.data.scope in ['ai-quote', 'client-error']
        && request.resource.data.count == 1
        && request.resource.data.windowStart <= request.time
        && request.time < request.resource.data.windowStart + duration.value(60, 's')
        && request.resource.data.expiresAt == request.resource.data.windowStart + duration.value(120, 's');
      allow update: if hasWorkspace()
        && resource.data.uid == request.auth.uid
        && resource.data.organizationId == organizationId()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.scope == resource.data.scope
        && request.resource.data.windowStart == resource.data.windowStart
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && request.time < resource.data.windowStart + duration.value(60, 's');
    }

    match /deletionRequests/{orgId} {
      allow create: if isOwner()
        && orgId == organizationId()
        && request.resource.data.organizationId == organizationId()
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isOwner() && orgId == organizationId();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
